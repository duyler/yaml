{
    "name": "duyler/yaml",
    "description": "YAML 1.2.2 parser with strict typing",
    "keywords": [
        "yaml",
        "parser"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mikhail Ilinsky",
            "email": "mail@milinsky.ru"
        }
    ],
    "require": {
        "php": "8.4 - 8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "friendsofphp/php-cs-fixer": "^3.80",
        "vimeo/psalm": "^6.10",
        "rector/rector": "^2.3",
        "infection/infection": "^0.32.0"
    },
    "autoload": {
        "psr-4": {
            "Duyler\\Yaml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duyler\\Yaml\\Test\\": ["tests/"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
